# 统一换行符，避免 Windows/Linux 互搞
* text=auto

# Shell / systemd / sudoers 必须是 LF，否则 Linux 上会挂
*.sh        text eol=lf
*.hook.chroot text eol=lf
*.service   text eol=lf
*.timer     text eol=lf
*.list.chroot text eol=lf
*.conf      text eol=lf
Dockerfile  text eol=lf

# PowerShell / 批处理用 CRLF
*.ps1       text eol=crlf
*.bat       text eol=crlf
*.cmd       text eol=crlf

# 二进制
*.png       binary
*.jpg       binary
*.ico       binary
*.iso       binary
*.gz        binary
*.xz        binary
*.zip       binary
*.sqlite    binary
