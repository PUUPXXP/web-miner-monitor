[Unit]
Description=MinerOS 启动配置（从 U 盘读取 rig.conf / 恢复数据分区 / 生成矿机身份）
DefaultDependencies=no
After=local-fs.target
Before=mineros-agent.service mineros-console.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/mineros-firstboot.sh
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
